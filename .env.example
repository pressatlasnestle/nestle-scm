# Supabase project (SCM — wbxxtreznqdawzhzbstk, ap-south-1)
# Copy to .env.local and fill in. The publishable/anon key is safe for the browser;
# it only grants access allowed by RLS. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only — full admin key that BYPASSES RLS. Never prefix with NEXT_PUBLIC_.
# From: Supabase Dashboard → Settings → API → service_role.
# Required for the admin invite-user flow. In production, set this in the
# hosting provider's env (e.g. Vercel → Project → Settings → Environment
# Variables, Production scope) — not committed here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
