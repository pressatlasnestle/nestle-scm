# Supabase project (SCM — wbxxtreznqdawzhzbstk, ap-south-1)
# Copy to .env.local and fill in. The publishable/anon key is safe for the browser;
# it only grants access allowed by RLS. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only — full admin key that BYPASSES RLS. Never prefix with NEXT_PUBLIC_.
# From: Supabase Dashboard → Settings → API → service_role.
# Required for the admin invite-user flow AND for every ingestion run (cron
# runs have no user session). In production, set this in the hosting provider's
# env (e.g. Vercel → Project → Settings → Environment Variables, Production
# scope) — not committed here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — shared secret authenticating cron-triggered ingestion runs
# against POST /api/ingestion/run. Generate any long random string, then store
# the SAME value in Supabase Vault so pg_cron can present it:
#   select vault.create_secret('<value>', 'ingestion_cron_secret',
#     'Shared secret authenticating cron-triggered ingestion runs');
# Also set app_settings.app_base_url to the app's public URL, or the scheduled
# run no-ops. See supabase/migrations/20260810000014_ingestion_cron.sql.
INGESTION_CRON_SECRET=
