{
  "name": "nestle-scm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "sort": "tsx --env-file=.env.local scripts/sort.ts",
    "code": "tsx --env-file=.env.local scripts/code.ts",
    "check": "npm run check:matcher && npm run check:dedup && npm run check:parser && npm run check:period && npm run check:coding",
    "check:matcher": "tsx scripts/checks/matcher.ts",
    "check:period": "tsx scripts/checks/period.ts",
    "check:coding": "tsx scripts/checks/coding.ts",
    "check:themes": "tsx --env-file=.env.local scripts/checks/themes.ts",
    "check:dedup": "tsx scripts/checks/dedup.ts",
    "check:parser": "tsx scripts/checks/parser.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "fast-xml-parser": "^5.10.1",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
